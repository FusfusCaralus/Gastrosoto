rules_version = '2';

// Cada cuenta (uid) solo puede leer y escribir sus propios datos, bajo
// users/{uid}/... — nadie puede ver ni tocar los datos de otra cuenta,
// ni siquiera estando identificado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
